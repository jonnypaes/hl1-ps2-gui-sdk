{
  "scopeName": "source.launcher",
  "name": "PS2 Launcher UI",
  "patterns": [
    { "match": "#.*$", "name": "comment.line.number-sign.launcher" },
    { "match": "!\\b(include|define)\\b", "name": "keyword.control.directive.launcher" },
    { "match": "\\b(GUI_SCREEN|GUI_GENERIC|GUI_DEPENDENCY|GUI_ELEMENT_STATE|END)\\b", "name": "keyword.control.structure.launcher" },
    { "match": "\\b(NAME|Z_PLANE|DEPENDS_VALUE|SCREEN_RECT|TEXTURE|COLOR|TEXT)\\b", "name": "support.type.property.launcher" },
    { "match": "\\b-?\\d+(\\.\\d+)?\\b", "name": "constant.numeric.launcher" },
    { "match": "\\b[A-Z][A-Z0-9_]{2,}\\b", "name": "constant.other.macro.launcher" },
    { "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b", "name": "entity.name.identifier.launcher" }
  ]
}